# 构建上下文瘦身（monorepo：必须保留根与三个 workspace 的 package.json + 根 lock）
.git
.gitignore
Dockerfile
.dockerignore
docker-compose.yml

# 依赖与构建产物（镜像内重新安装/构建）
node_modules
**/node_modules
server/dist
web/dist

# 小程序源码不进镜像（保留 package.json 供 npm ci 解析 workspaces）
miniprogram/*
!miniprogram/package.json

# 运行时数据
server/uploads
ssl
data

# 本地环境与文档
.env
.env.local
.env.*.local
*.md
